// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// What an account may do. Enforced in every server action, not just in the
/// navigation — the actions are public HTTP endpoints.
enum Role {
  ADMIN
  OFFICE
  TEACHER
}

/// One row per role-capability the school has changed from the built-in default.
/// Absence means "use the default", so a fresh install needs no seeding and an
/// added capability starts from sensible ground rather than denied-for-everyone.
model RolePermission {
  id         Int     @id @default(autoincrement())
  role       Role
  capability String
  granted    Boolean

  @@unique([role, capability])
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  role         Role     @default(OFFICE)
  // Optional so the column can be added to a table that already has rows, and
  // so accounts created before email existed keep working. Postgres permits
  // many NULLs under a unique index, so those rows do not collide.
  // Always stored lowercased — see normalizeEmail() in src/lib/auth/identity.ts.
  email        String?  @unique
  passwordHash String
  createdAt    DateTime @default(now())

  staff              Staff?
  conductRecorded    ConductEntry[]
  activitiesRecorded ActivityEntry[]
  restorePoints      RestorePoint[]
  paymentsReceived   Payment[]
  feeNotes           FeeNote[]
  announcements      Announcement[]
  announcementReads  AnnouncementRead[]
}

// ---------------------------------------------------------------------------
// Registry — the spine attendance and assessment will read through.
// Dates are stored Gregorian and rendered as Bikram Sambat; see src/lib/date/bs.ts.
// ---------------------------------------------------------------------------

/// Baisakh–Chaitra. Only one row may have isCurrent set; enforced in the service layer.
model AcademicYear {
  id        Int      @id @default(autoincrement())
  nameBS    String   @unique
  startsOn  DateTime @db.Date
  endsOn    DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  sections        Section[]
  offerings       SubjectOffering[]
  enrollments     Enrollment[]
  attendance      AttendanceSession[]
  examTerms       ExamTerm[]
  conduct         ConductEntry[]
  activities      ActivityEntry[]
  feeStructures   FeeStructure[]
  studentFeePlans StudentFeePlan[]
  invoices        Invoice[]
  payments        Payment[]
}

/// A year group: "Class 5". `order` drives sorting and year-end promotion.
model Grade {
  id    Int    @id @default(autoincrement())
  name  String @unique
  order Int    @unique

  sections      Section[]
  offerings     SubjectOffering[]
  feeStructures FeeStructure[]
}

model Section {
  id             Int    @id @default(autoincrement())
  name           String
  gradeId        Int
  academicYearId Int
  classTeacherId Int?

  grade        Grade               @relation(fields: [gradeId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  classTeacher Staff?              @relation(fields: [classTeacherId], references: [id])
  enrollments  Enrollment[]
  assignments  TeacherAssignment[]
  attendance   AttendanceSession[]
  timetable    TimetablePeriod[]

  @@unique([gradeId, academicYearId, name])
}

model Subject {
  id   Int    @id @default(autoincrement())
  /// Unique on its own now: the old short code was a second identifier that
  /// only produced duplicate-key errors, and the id is the real key.
  name String @unique

  offerings SubjectOffering[]
}

/// One subject as taught to one grade in one year, with its mark scheme.
model SubjectOffering {
  id                 Int     @id @default(autoincrement())
  subjectId          Int
  gradeId            Int
  academicYearId     Int
  hasPractical       Boolean @default(false)
  fullMarksTheory    Int
  passMarksTheory    Int
  fullMarksPractical Int?
  passMarksPractical Int?

  subject      Subject             @relation(fields: [subjectId], references: [id])
  grade        Grade               @relation(fields: [gradeId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  assignments  TeacherAssignment[]
  marks        Mark[]

  @@unique([subjectId, gradeId, academicYearId])
}

model Staff {
  id          Int      @id @default(autoincrement())
  userId      Int?     @unique
  photoId     Int?     @unique
  firstName   String   @default("")
  middleName  String?
  lastName    String   @default("")
  /// Derived from the name parts on write, so sorting and search stay simple.
  fullName    String
  fullNameNp  String?
  phone       String
  designation String
  joinedOn    DateTime @db.Date
  isActive    Boolean  @default(true)

  user           User?               @relation(fields: [userId], references: [id])
  photo          Photo?              @relation(fields: [photoId], references: [id])
  assignments    TeacherAssignment[]
  sectionsLed    Section[]
  attendanceKept AttendanceSession[]
}

/// Scopes which section-subject pairs a teacher may enter marks for later.
model TeacherAssignment {
  id                Int @id @default(autoincrement())
  staffId           Int
  sectionId         Int
  subjectOfferingId Int

  staff           Staff             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  section         Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering   @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  timetable       TimetablePeriod[]

  @@unique([staffId, sectionId, subjectOfferingId])
}

/// A named shape for a school day — "Regular day", "Half day". Periods belong
/// to a shape rather than to the school, so Friday can finish early without
/// every other day having to be edited to match.
model DayShape {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  /// The shape a weekday falls back to when nothing else is assigned, and the
  /// one the seed and the migration attach existing periods to. Exactly one
  /// row is true; enforced in the library, not the schema.
  isDefault Boolean @default(false)

  periods  SchoolPeriod[]
  weekdays WeekdayShape[]
}

/// Which shape each weekday runs. Absent means the default shape.
model WeekdayShape {
  /// Sunday = 0 through Saturday = 6, matching JavaScript's getDay().
  dayOfWeek  Int @id
  dayShapeId Int

  dayShape DayShape @relation(fields: [dayShapeId], references: [id])
}

/// What a slot in the day is for. A teaching period carries a lesson; a break
/// carries none; an event occupies the slot with a labelled activity instead
/// of a lesson.
enum PeriodKind {
  TEACHING
  BREAK
  /// Extra-curricular, assembly, club time. Occupies a slot, carries a label,
  /// takes no teacher or subject.
  EVENT
}

/// The school's bell schedule: the named slots a shape's week is built from.
/// Break rows carry no lesson but keep the grid honest about the gap.
/// Minutes since midnight avoid attaching a timezone or arbitrary date to a
/// wall-clock time.
///
/// `order` is deliberately not unique on its own, so a shape's schedule can be
/// renumbered in one transaction without rows colliding mid-flight. Contiguity
/// is a service-layer rule — see validateBell() in src/lib/timetable/bell.ts.
model SchoolPeriod {
  id          Int        @id @default(autoincrement())
  order       Int
  name        String
  startMinute Int
  endMinute   Int
  dayShapeId  Int
  kind        PeriodKind @default(TEACHING)
  /// Shown in the grid for an EVENT period. Empty for the other kinds.
  label       String     @default("")

  dayShape DayShape          @relation(fields: [dayShapeId], references: [id])
  periods  TimetablePeriod[]

  @@unique([dayShapeId, order])
}

/// One recurring weekly lesson: a teaching assignment placed in a bell slot on
/// a given weekday. Times are not stored here — they belong to the bell period,
/// so moving Period 3 moves every Period 3 lesson with it.
model TimetablePeriod {
  id                  Int    @id @default(autoincrement())
  teacherAssignmentId Int
  /// Denormalised from the assignment so "one lesson per section per slot" can
  /// be a database constraint rather than a hope. setTimetableCell() is the
  /// only writer and always sets it to assignment.sectionId.
  sectionId           Int
  schoolPeriodId      Int
  /// Sunday = 0 through Saturday = 6, matching JavaScript's getDay().
  dayOfWeek           Int
  room                String @default("")

  assignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)
  section      Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  schoolPeriod SchoolPeriod      @relation(fields: [schoolPeriodId], references: [id], onDelete: Cascade)

  @@unique([sectionId, dayOfWeek, schoolPeriodId])
  // Pinned: the live index name was hand-shortened (dropped the trailing "Id")
  // to fit Postgres's 63-byte identifier limit when this migration was hand-
  // written. Mapping it here keeps the schema in agreement with the database
  // instead of Prisma proposing a rename to its own longer default.
  @@unique([teacherAssignmentId, dayOfWeek, schoolPeriodId], map: "TimetablePeriod_teacherAssignmentId_dayOfWeek_schoolPeriod_key")
  @@index([dayOfWeek])
}

model Student {
  id          Int           @id @default(autoincrement())
  admissionNo String        @unique
  photoId     Int?          @unique
  firstName   String        @default("")
  middleName  String?
  lastName    String        @default("")
  /// Derived from the name parts on write, so sorting and search stay simple.
  fullName    String
  fullNameNp  String?
  dob         DateTime      @db.Date
  gender      Gender
  address     String?
  admittedOn  DateTime      @db.Date
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  photo       Photo?             @relation(fields: [photoId], references: [id])
  guardians   Guardian[]
  enrollments Enrollment[]
  attendance  AttendanceRecord[]
  marks       Mark[]
  conduct     ConductEntry[]
  activities  ActivityEntry[]
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Students are marked LEFT rather than deleted, so their history survives.
enum StudentStatus {
  ACTIVE
  LEFT
  GRADUATED
}

model Guardian {
  id         Int              @id @default(autoincrement())
  studentId  Int
  relation   GuardianRelation
  fullName   String
  phone      String
  occupation String?
  isPrimary  Boolean          @default(false)

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]
}

/// One running note per pupil per year: the arrangement the office has with a
/// family, not a record of one transaction.
///
/// Deliberately not a column on Enrollment — that table belongs to the
/// registry, and this is a fees concern that happens to be keyed the same way.
model FeeNote {
  id           Int      @id @default(autoincrement())
  enrollmentId Int      @unique
  body         String
  updatedAt    DateTime @updatedAt
  updatedById  Int?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  updatedBy  User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
}

/// A student's place in one section for one year. Roll numbers are unique
/// within a section and year, never globally.
model Enrollment {
  id             Int      @id @default(autoincrement())
  studentId      Int
  sectionId      Int
  academicYearId Int
  rollNo         Int
  enrolledOn     DateTime @db.Date

  student               Student                @relation(fields: [studentId], references: [id])
  section               Section                @relation(fields: [sectionId], references: [id])
  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id])
  invoices              Invoice[]
  feeNote               FeeNote?
  transportRegistration TransportRegistration?
  studentFeeAssignments StudentFeeAssignment[]

  @@unique([studentId, academicYearId])
  @@unique([sectionId, academicYearId, rollNo])
}

// ---------------------------------------------------------------------------
// Fees — immutable invoice lines and payment allocations keep partial payments
// and reversals auditable without changing a student's historical class/year.
// ---------------------------------------------------------------------------

enum FeeFrequency {
  ONE_TIME
  MONTHLY
  TERMLY
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  COMPLETED
  REVERSED
}

enum FeeBillingScope {
  CLASS
  TRANSPORT
  STUDENT
}

model StudentFeePlan {
  id             Int                    @id @default(autoincrement())
  academicYearId Int
  feeHeadId      Int
  amount         Int
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id])
  feeHead        FeeHead                @relation(fields: [feeHeadId], references: [id])
  assignments    StudentFeeAssignment[]

  @@unique([academicYearId, feeHeadId])
}

model StudentFeeAssignment {
  id           Int            @id @default(autoincrement())
  planId       Int
  enrollmentId Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  plan         StudentFeePlan @relation(fields: [planId], references: [id])
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id])
  invoices     Invoice[]

  @@unique([planId, enrollmentId])
  @@index([enrollmentId])
}

model TransportRegistration {
  id             Int      @id @default(autoincrement())
  enrollmentId   Int      @unique
  pickupLocation String
  monthlyAmount  Int
  startMonth     Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  invoices   Invoice[]
}

model FeeHead {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  isActive     Boolean         @default(true)
  /// How often this charge is raised. A property of the fee itself, not of the
  /// class paying it — "Library, monthly" is true school-wide, and holding it
  /// per class would let Admission be one-time for one grade and monthly for
  /// another.
  frequency    FeeFrequency    @default(ONE_TIME)
  billingScope FeeBillingScope @default(CLASS)
  createdAt    DateTime        @default(now())

  structureLines  FeeStructureLine[]
  studentFeePlans StudentFeePlan[]
  invoiceLines    InvoiceLine[]
}

model FeeStructure {
  id             Int      @id @default(autoincrement())
  academicYearId Int
  gradeId        Int
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  grade        Grade              @relation(fields: [gradeId], references: [id])
  lines        FeeStructureLine[]
  invoices     Invoice[]

  @@unique([academicYearId, gradeId, name])
}

model FeeStructureLine {
  id             Int @id @default(autoincrement())
  feeStructureId Int
  feeHeadId      Int
  amount         Int

  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeHead      FeeHead      @relation(fields: [feeHeadId], references: [id])

  @@unique([feeStructureId, feeHeadId])
}

model Invoice {
  id                      Int           @id @default(autoincrement())
  enrollmentId            Int
  academicYearId          Int
  feeStructureId          Int?
  transportRegistrationId Int?
  studentFeeAssignmentId  Int?
  number                  String        @unique
  issuedOn                DateTime      @db.Date
  dueOn                   DateTime?     @db.Date
  status                  InvoiceStatus @default(ISSUED)
  /// Which instalment this bill is: 1-12 for a monthly fee (the BS month), 0
  /// for a one-time charge like admission.
  ///
  /// 0 rather than NULL because it sits in the unique index below. Postgres
  /// treats every NULL there as distinct, so a nullable column would quietly
  /// stop the index blocking duplicate one-time invoices — the guard that
  /// exists today.
  periodMonth             Int           @default(0)
  createdAt               DateTime      @default(now())

  enrollment            Enrollment             @relation(fields: [enrollmentId], references: [id])
  academicYear          AcademicYear           @relation(fields: [academicYearId], references: [id])
  feeStructure          FeeStructure?          @relation(fields: [feeStructureId], references: [id])
  transportRegistration TransportRegistration? @relation(fields: [transportRegistrationId], references: [id])
  studentFeeAssignment  StudentFeeAssignment?  @relation(fields: [studentFeeAssignmentId], references: [id])
  lines                 InvoiceLine[]

  @@unique([enrollmentId, feeStructureId, periodMonth])
  @@unique([transportRegistrationId, periodMonth])
  @@unique([studentFeeAssignmentId, periodMonth])
  @@index([academicYearId, status])
  @@index([enrollmentId])
}

model InvoiceLine {
  id          Int    @id @default(autoincrement())
  invoiceId   Int
  feeHeadId   Int
  description String
  amount      Int

  invoice     Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead     FeeHead             @relation(fields: [feeHeadId], references: [id])
  allocations PaymentAllocation[]

  @@index([feeHeadId])
}

model Payment {
  id               Int           @id @default(autoincrement())
  academicYearId   Int
  receiptNo        String        @unique
  amount           Int
  paidOn           DateTime      @db.Date
  method           PaymentMethod @default(CASH)
  reference        String?
  /// Who handed the money over. Name and phone are snapshotted rather than
  /// read through the guardian link, because a receipt must keep saying what
  /// it said the day it was printed. The link is kept for provenance; for a
  /// payer who is not a guardian it is simply null.
  paidByGuardianId Int?
  paidByName       String?
  paidByPhone      String?
  status           PaymentStatus @default(COMPLETED)
  receivedById     Int?
  createdAt        DateTime      @default(now())

  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id])
  receivedBy     User?               @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  paidByGuardian Guardian?           @relation(fields: [paidByGuardianId], references: [id], onDelete: SetNull)
  allocations    PaymentAllocation[]
  request        PaymentRequest?

  @@index([academicYearId, paidOn])
}

/// Append-only operational history. Actor and year identifiers are snapshots,
/// not foreign keys: deleting an account must not erase its accountability.
model PaymentRequest {
  key         String  @id
  paymentId   Int     @unique
  fingerprint String
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model AuditEvent {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  actorUserId    Int
  actorUsername  String
  action         String
  entityType     String
  entityId       String
  academicYearId Int?
  details        Json

  @@index([createdAt, id])
  @@index([academicYearId, createdAt])
}

model PaymentAllocation {
  id            Int @id @default(autoincrement())
  paymentId     Int
  invoiceLineId Int
  amount        Int

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLine @relation(fields: [invoiceLineId], references: [id])

  @@unique([paymentId, invoiceLineId])
  @@index([invoiceLineId])
}

// ---------------------------------------------------------------------------
// Attendance — taken once a day per section, not per period.
// ---------------------------------------------------------------------------

/// One roll call. Existence of a session is what distinguishes "everyone was
/// present" from "nobody took attendance that day".
model AttendanceSession {
  id             Int      @id @default(autoincrement())
  sectionId      Int
  academicYearId Int
  date           DateTime @db.Date
  takenById      Int?
  takenAt        DateTime @default(now())

  section      Section            @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  takenBy      Staff?             @relation(fields: [takenById], references: [id])
  records      AttendanceRecord[]

  @@unique([sectionId, date])
}

model AttendanceRecord {
  id        Int              @id @default(autoincrement())
  sessionId Int
  studentId Int
  status    AttendanceStatus
  note      String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

/// Passport-style photo for a student or staff member. Stored in the database
/// because this is a single-school deployment of a few hundred people; move to
/// object storage if that ever stops being true.
model Photo {
  id        Int      @id @default(autoincrement())
  data      Bytes
  mimeType  String
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  student Student?
  staff   Staff?
  school  SchoolProfile?
}

/// The school's own details, for letterheads on printed documents. A single
/// row: this is one school's system, not a directory of them.
model SchoolProfile {
  id               Int      @id @default(1)
  name             String
  nameNp           String?
  address          String?
  phone            String?
  email            String?
  logoId           Int?     @unique
  /// Which weekdays the school runs, Sunday = 0. Saturday is the weekly holiday
  /// in Nepal, but enough schools differ for this to be a setting.
  workingDays      Int[]    @default([0, 1, 2, 3, 4, 5])
  /// How the honours score is weighted, in percent. Must sum to 100; enforced
  /// in src/lib/honours/weights.ts.
  weightExams      Int      @default(50)
  weightAttendance Int      @default(20)
  weightConduct    Int      @default(15)
  weightActivities Int      @default(15)
  updatedAt        DateTime @updatedAt

  logo Photo? @relation(fields: [logoId], references: [id])
}

// ---------------------------------------------------------------------------
// Assessment — terminal exams and the marks recorded against them.
// ---------------------------------------------------------------------------

/// A terminal exam: First Terminal, Second Terminal, Final, and so on. `order`
/// puts them in sequence within the year; `isPublished` gates whether results
/// are treated as final.
model ExamTerm {
  id             Int       @id @default(autoincrement())
  academicYearId Int
  name           String
  order          Int
  startsOn       DateTime? @db.Date
  endsOn         DateTime? @db.Date
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  marks        Mark[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, order])
}

/// One student's result in one subject for one exam. Theory and practical are
/// stored separately because they are passed separately, and null means the
/// mark has not been entered yet — which is not the same as zero.
model Mark {
  id                Int      @id @default(autoincrement())
  examTermId        Int
  studentId         Int
  subjectOfferingId Int
  theory            Int?
  practical         Int?
  /// Absent from the exam. Kept apart from a zero, which is a sat-and-failed.
  isAbsent          Boolean  @default(false)
  updatedAt         DateTime @updatedAt

  examTerm        ExamTerm        @relation(fields: [examTermId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id])
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id])

  @@unique([examTermId, studentId, subjectOfferingId])
  @@index([studentId])
  @@index([subjectOfferingId])
}

// ---------------------------------------------------------------------------
// Honours — the conduct and activity records that, with exams and attendance,
// make up a student's overall score. See src/lib/honours/score.ts.
// ---------------------------------------------------------------------------

/// One conduct event. `points` is always positive; `kind` gives it its sign.
model ConductEntry {
  id             Int         @id @default(autoincrement())
  studentId      Int
  academicYearId Int
  kind           ConductKind
  points         Int
  date           DateTime    @db.Date
  note           String
  recordedById   Int?
  createdAt      DateTime    @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, academicYearId])
}

enum ConductKind {
  MERIT
  DEMERIT
}

/// One participation in a co-curricular activity. Points are stored rather
/// than derived from the level so a national win can outweigh a house match.
model ActivityEntry {
  id             Int           @id @default(autoincrement())
  studentId      Int
  academicYearId Int
  name           String
  level          ActivityLevel
  points         Int
  date           DateTime      @db.Date
  recordedById   Int?
  createdAt      DateTime      @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  recordedBy   User?        @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([studentId, academicYearId])
}

enum ActivityLevel {
  PARTICIPATED
  PLACED
  WON
}

// ---------------------------------------------------------------------------
// Year teardown — deleting an academic year and everything recorded in it,
// only after a restore point is captured. See docs/superpowers/specs.
// ---------------------------------------------------------------------------

/// A year's rows, captured before that year was deleted, so it can be brought
/// back. Held in the database rather than a file so it travels with the
/// school's existing backups.
model RestorePoint {
  id          Int      @id @default(autoincrement())
  /// Kept as plain values rather than a relation: the year this names is gone
  /// by the time anyone needs the snapshot.
  yearNameBS  String
  startsOn    DateTime @db.Date
  endsOn      DateTime @db.Date
  createdAt   DateTime @default(now())
  createdById Int?
  /// Row counts per table, so the list reads without parsing the payload.
  counts      Json
  /// Every captured row, keyed by table, each carrying its original id.
  payload     Json
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Announcements — notices from the office to the people who work here.
// ---------------------------------------------------------------------------

/// Who a notice is for. By role rather than by person: a school's messages are
/// "for teachers" or "for everyone", and a list of named recipients would have
/// to be rebuilt every time somebody is hired or changes job.
enum AnnouncementAudience {
  ALL
  TEACHER
  OFFICE
}

/// One notice. Kept after it expires rather than deleted, so "what did the
/// office say in Bhadra" still has an answer.
model Announcement {
  id        Int                  @id @default(autoincrement())
  title     String
  body      String
  audience  AnnouncementAudience @default(ALL)
  /// Sits above the rest whatever its date, for the handful of notices that
  /// stay true all year — exam week, the fee deadline, the fire drill.
  isPinned  Boolean              @default(false)
  /// Date-only, like every other school date. Null means it never expires;
  /// a notice stops showing after this day rather than on it, so "expires
  /// today" is still readable today.
  expiresOn DateTime?            @db.Date
  authorId  Int?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  /// Optional, and kept when the account goes: a notice outlives the person
  /// who wrote it, and losing the notice would be the worse loss.
  author User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reads  AnnouncementRead[]

  @@index([audience, expiresOn])
}

/// One row per person who has read a notice. Absence is unread, so somebody
/// hired today does not arrive to a year of notices already marked read.
model AnnouncementRead {
  id             Int      @id @default(autoincrement())
  announcementId Int
  userId         Int
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}
